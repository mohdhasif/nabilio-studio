# Public URL of the deployed site (no trailing slash). Used for canonical URLs,
# Open Graph, sitemap and robots. On Vercel, if unset, the production
# *.vercel.app domain is used automatically.
NEXT_PUBLIC_SITE_URL=

# Contact details. Optional — override the defaults in src/config/site.ts.
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp number in international format, digits only (e.g. 60123456789)
NEXT_PUBLIC_WHATSAPP_NUMBER=
